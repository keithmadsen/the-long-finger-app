{
  "name": "the-long-finger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:css": "npm run lint:css --workspace apps/web",
    "lint:css:selftest": "npm run lint:css:selftest --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspace apps/api",
    "test:integration": "npm run test:integration --workspace apps/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
