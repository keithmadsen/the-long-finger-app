# Port the Fastify API listens on (dev default: 3001).
# The Vite dev server proxies /todos and /health to this port.
PORT=3001

# Path to the on-disk SQLite database file (relative to apps/api, or absolute).
# In production this points at a mounted volume for durability across restarts.
DATABASE_PATH=./data/todos.db

# Container defaults (baked into the Dockerfile): PORT=8080 and
# DATABASE_PATH=/data/todos.db, where /data is a mounted volume. See the
# "Running the container" section in README.md for the build/run command.
