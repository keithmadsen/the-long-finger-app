# Playwright E2E harness — copy to e2e/.env for local overrides (gitignored).

# The origin Playwright drives. Default is the Vite dev server, which proxies
# /todos and /health to the Fastify API — one logical origin for UI + API tests.
BASE_URL=http://localhost:5173

# Isolated SQLite file the harness boots the API against (resolved relative to
# apps/api, its dev cwd). Keeps E2E runs from touching dev data. *.db is gitignored.
E2E_DATABASE_PATH=./data/e2e.db
